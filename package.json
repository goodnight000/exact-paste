{
  "name": "exact-paste",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Paste the exact value a Chrome form field wants, or the whole copied text.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goodnight000/exact-paste.git"
  },
  "bugs": {
    "url": "https://github.com/goodnight000/exact-paste/issues"
  },
  "homepage": "https://github.com/goodnight000/exact-paste",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "exact-paste": "./bin/exact-paste.mjs"
  },
  "scripts": {
    "start": "node bin/exact-paste.mjs",
    "setup": "node bin/exact-paste.mjs",
    "build": "node scripts/build.mjs",
    "demo": "python3 -m http.server 4173 --directory demo",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "eval": "node scripts/run-eval.mjs",
    "open": "node scripts/open-chrome.mjs"
  },
  "dependencies": {
    "puppeteer-core": "^24.15.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "esbuild": "^0.25.9",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
