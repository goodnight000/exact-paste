{
  "name": "exact-paste",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "description": "Paste the exact value a Chrome form field wants, or the whole copied text.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goodnight000/exact-paste.git"
  },
  "bugs": {
    "url": "https://github.com/goodnight000/exact-paste/issues"
  },
  "homepage": "https://github.com/goodnight000/exact-paste",
  "license": "MIT",
  "engines": {
    "node": ">=22.15.0"
  },
  "bin": {
    "exact-paste": "./bin/exact-paste.mjs"
  },
  "scripts": {
    "start": "node bin/exact-paste.mjs",
    "setup": "node bin/exact-paste.mjs",
    "build": "node scripts/build.mjs",
    "demo": "node scripts/demo.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "eval": "node scripts/run-eval.mjs",
    "open": "node scripts/open-chrome.mjs",
    "package": "node scripts/package.mjs",
    "verify": "node scripts/verify.mjs",
    "rehearse": "node --env-file-if-exists=.env scripts/rehearse.mjs",
    "record-demo": "node scripts/record-demo.mjs"
  },
  "dependencies": {
    "puppeteer-core": "^25.13.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.20.5",
    "esbuild": "^0.25.9",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11"
  }
}
