{
  "manifest_version": 3,
  "name": "Exact Paste",
  "version": "0.1.1",
  "description": "Paste the exact value a form field wants, or the whole copied text.",
  "permissions": ["storage"],
  "host_permissions": ["https://api.typesafe.ai/*"],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Exact Paste",
    "default_popup": "options.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "commands": {
    "toggle-exact-paste": {
      "suggested_key": {
        "default": "Alt+Shift+V"
      },
      "description": "Turn Exact Paste on or off"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
